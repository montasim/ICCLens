{
  "name": "icc-lens-workspace",
  "description": "A clearer, faster Chrome interface for the ICC local media server, with a public product website.",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=11 <12"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/montasim/ICCLens.git"
  },
  "bugs": {
    "url": "https://github.com/montasim/ICCLens/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Montasim",
    "url": "https://github.com/montasim"
  },
  "scripts": {
    "dev": "pnpm dev:extension",
    "dev:extension": "pnpm --filter @icc-lens/extension dev",
    "dev:web": "pnpm --filter @icc-lens/web dev",
    "assets": "pnpm --filter @icc-lens/extension assets",
    "init:product": "node scripts/init-product.mjs",
    "build": "pnpm build:extension && pnpm build:web",
    "build:extension": "pnpm --filter @icc-lens/extension build",
    "build:web": "pnpm --filter @icc-lens/web build",
    "zip": "pnpm --filter @icc-lens/extension zip",
    "compile": "pnpm typecheck",
    "typecheck": "pnpm --filter @icc-lens/extension typecheck && pnpm --filter @icc-lens/web typecheck",
    "format": "prettier --write . && eslint . --fix",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "test": "pnpm --filter @icc-lens/extension test",
    "test:e2e": "pnpm --filter @icc-lens/extension test:e2e",
    "verify:build": "node scripts/verify-build.mjs",
    "verify:package": "node scripts/verify-package.mjs",
    "verify:prototype": "node scripts/verify-prototype.mjs",
    "verify:prototype:approved": "node scripts/verify-prototype.mjs --approved",
    "verify:toolchain": "node scripts/verify-toolchain.mjs",
    "verify:release-config": "node scripts/verify-build.mjs --release-config-only",
    "check:fast": "pnpm format:check && pnpm verify:prototype:approved && pnpm verify:toolchain && pnpm lint && pnpm typecheck && pnpm test",
    "check": "pnpm check:fast && pnpm build:extension && pnpm verify:build && pnpm test:e2e && pnpm build:web",
    "check:release": "pnpm check && pnpm verify:release-config && pnpm zip && pnpm verify:package"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@typescript/native": "npm:typescript@7.0.2",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fflate": "^0.8.3",
    "globals": "^17.11.0",
    "prettier": "^3.9.5",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.68.0"
  }
}
