{
  "name": "icc-lens",
  "description": "A clearer, faster catalog interface for the ICC local media server.",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/montasim/ICCLens.git"
  },
  "bugs": {
    "url": "https://github.com/montasim/ICCLens/issues"
  },
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=11 <12"
  },
  "scripts": {
    "dev": "wxt --browser chrome",
    "assets": "node scripts/generate-assets.mjs",
    "init:product": "node scripts/init-product.mjs",
    "build": "pnpm assets && wxt build --browser chrome",
    "zip": "pnpm assets && wxt zip --browser chrome",
    "compile": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write . && eslint . --fix",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "verify:build": "node scripts/verify-build.mjs",
    "verify:package": "node scripts/verify-package.mjs",
    "verify:prototype": "node scripts/verify-prototype.mjs",
    "verify:prototype:approved": "node scripts/verify-prototype.mjs --approved",
    "verify:toolchain": "node scripts/verify-toolchain.mjs",
    "verify:release-config": "node scripts/verify-build.mjs --release-config-only",
    "check:fast": "pnpm format:check && pnpm verify:toolchain && pnpm lint && pnpm typecheck && pnpm test",
    "check": "pnpm check:fast && pnpm build && pnpm verify:build && pnpm test:e2e",
    "check:release": "pnpm check && pnpm verify:release-config && pnpm zip && pnpm verify:package",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@hugeicons/core-free-icons": "^4.3.0",
    "@hugeicons/react": "^1.1.10",
    "@tailwindcss/vite": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/chrome": "^0.1.32",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@typescript/native": "npm:typescript@7.0.2",
    "@wxt-dev/module-react": "^1.2.2",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fflate": "^0.8.3",
    "globals": "^17.11.0",
    "happy-dom": "^20.10.6",
    "prettier": "^3.9.5",
    "sharp": "^0.35.4",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11",
    "wxt": "^0.21.4"
  }
}
